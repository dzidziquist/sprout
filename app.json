{
  "expo": {
    "name": "PlantFam",
    "slug": "plantfam",
    "version": "1.0.16",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "plantfam",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dzidziquist.plantfam",
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.dzidziquist.plantfam"]
      },
      "icon": {
        "light": "./assets/icons/icon-default.png",
        "dark": "./assets/icons/icon-default-dark.png",
        "tinted": "./assets/icons/icon-default-tinted.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"] }
        ]
      }
    },
    "android": {
      "package": "com.dzidziquist.plantfam"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PlantFam uses your phone’s compass to tell which way a window faces. Your location isn’t saved or shared.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#3DDC84"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3DDC84",
          "image": "./assets/art/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withHousehold",
      [
        "react-native-cloud-storage",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PlantFam uses the camera so you can snap your plants for their photo diary, identify them, check a problem or measure the light where they sit.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PlantFam opens your photos so you can add one to a plant's diary, identify a plant or check a problem. Only the photos you choose are used.",
          "cameraPermission": "PlantFam uses the camera so you can snap your plants for their photo diary, identify them, check a problem or measure the light where they sit.",
          "microphonePermission": false
        }
      ],
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Night",
            "ios": {
              "light": "./assets/icons/icon-night.png",
              "dark": "./assets/icons/icon-night-dark.png",
              "tinted": "./assets/icons/icon-night-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-night-foreground.png",
              "backgroundColor": "#0C1F4E"
            }
          },
          {
            "name": "Cactus",
            "ios": {
              "light": "./assets/icons/icon-cactus.png",
              "dark": "./assets/icons/icon-cactus-dark.png",
              "tinted": "./assets/icons/icon-cactus-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-cactus-foreground.png",
              "backgroundColor": "#FFD23F"
            }
          },
          {
            "name": "Sunny",
            "ios": {
              "light": "./assets/icons/icon-sunny.png",
              "dark": "./assets/icons/icon-sunny-dark.png",
              "tinted": "./assets/icons/icon-sunny-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-sunny-foreground.png",
              "backgroundColor": "#8CC8FF"
            }
          },
          {
            "name": "Party",
            "ios": {
              "light": "./assets/icons/icon-party.png",
              "dark": "./assets/icons/icon-party-dark.png",
              "tinted": "./assets/icons/icon-party-tinted.png"
            },
            "android": {
              "foregroundImage": "./assets/icons/icon-party-foreground.png",
              "backgroundColor": "#C9B8FF"
            }
          }
        ]
      ],
      "./plugins/withPodDeploymentTarget"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c38ef09-43ce-46dd-b05f-0bcc755365d1"
      }
    },
    "owner": "dzidziquist",
    "icon": "./assets/icons/icon-default.png"
  }
}
