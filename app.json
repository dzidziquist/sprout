{
  "expo": {
    "name": "PlantFam",
    "slug": "plantfam",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "plantfam",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dzidziquist.plantfam",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dzidziquist.plantfam"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#3DDC84"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3DDC84"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PlantFam opens your photos so you can pick a plant to identify. Only the photo you choose is used.",
          "cameraPermission": "PlantFam uses the camera to snap a plant so we can help work out who it is.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "router": {}
    },
    "owner": "dzidziquist"
  }
}
